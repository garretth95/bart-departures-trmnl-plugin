<style>
    .bart-fit { width: 1%; white-space: nowrap; }
    .bart-line { padding-right: 12px; }
    .bart-time { text-align: right; }
    .bart-dest { max-width: 0; width: 100%; }
    .bart-dest .label { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* grouped: destination and times hug their content (capped), Line soaks up the leftover width */
    .bart-grouped .bart-dest { max-width: none; width: 1%; padding-right: 12px; }
    .bart-grouped .bart-dest .label { max-width: 40cqw; }
    .bart-grouped .bart-line { width: auto; }
    .bart-grouped .bart-time { text-align: left; }
    .bart-times { width: 1%; white-space: nowrap; }
    .bart-times__list { display: flex; flex-wrap: wrap; width: max-content; max-width: 45cqw; max-height: 1lh; overflow: hidden; }
    .bart-t { white-space: nowrap; }
    /* narrow views: exactly 3 times, destination fills whatever is left */
    .view--half_vertical .bart-grouped .bart-dest, .view--quadrant .bart-grouped .bart-dest { max-width: 0; width: 100%; }
    .view--half_vertical .bart-grouped .bart-dest .label, .view--quadrant .bart-grouped .bart-dest .label { max-width: none; }
    .view--half_vertical .bart-times__list, .view--quadrant .bart-times__list { flex-wrap: nowrap; max-width: none; max-height: none; }
    .view--half_vertical .bart-t:nth-child(n+4), .view--quadrant .bart-t:nth-child(n+4) { display: none; }
    .layout { row-gap: 0; }
    .layout > .columns { flex: 0 1 auto; min-height: 0; }
    .bart-lane { flex: 1 1 0; min-height: 0; overflow: hidden; display: flex; flex-direction: column; flex-wrap: wrap; justify-content: flex-end; align-content: flex-start; }
    .bart-lane > * { flex: none; width: 100%; }
    .bart-lane__probe { height: 0; }
    .bart-lane__track { padding-top: 12px; border-bottom: 2px solid #000; }
    .bart-train { display: block; }
</style>

<div class="layout layout--col layout--top layout--stretch pb--1">
    <div class="columns">
        <div class="column">

            {% if shown_count > 0 %}

                <table class="table {{ table_size }} bart-{{ layout }}" data-table-limit="true">
                    <thead>
                    <tr>
                        <th><span class="title title--small">Destination</span></th>
                        <th class="bart-fit bart-line"><span class="title title--small">Line</span></th>
                        <th class="{% if layout == "grouped" %}bart-times{% else %}bart-fit{% endif %} bart-time"><span class="title title--small">{% if layout == "grouped" %}Next Trains{% else %}Departs{% endif %}</span></th>
                    </tr>
                    </thead>

                    <tbody>
                    {% if layout == "grouped" %}
                        {% for g in groups %}{% if g != "" %}
                            {% assign g_dest = g | split: "|" | first %}
                            {% assign g_color = g | split: "|" | last %}
                            {% assign g_times = "" %}
                            {% assign g_n = 0 %}
                            {% for d in departures %}
                                {% capture tok %},{{ forloop.index0 }},{% endcapture %}
                                {% assign d_color = d.line | split: "-" | first %}
                                {% if g_n < 5 and shown_idx contains tok and d.dest == g_dest and d_color == g_color %}
                                    {% assign t = d.time | date: "%s" | plus: trmnl.user.utc_offset | date: "%-I:%M" %}
                                    {% assign g_times = g_times | append: '<span class="bart-t">' %}
                                    {% if g_n > 0 %}{% assign g_times = g_times | append: "&nbsp;&middot;&nbsp;" %}{% endif %}
                                    {% assign g_times = g_times | append: t | append: "</span>" %}
                                    {% assign g_n = g_n | plus: 1 %}
                                {% endif %}
                            {% endfor %}
                            <tr>
                                <td class="bart-dest"><span class="label {{ dest_size }}">{{ g_dest }}</span></td>
                                <td class="bart-fit bart-line"><span class="label label--outline {{ meta_size }}">{{ g_color | upcase }}</span></td>
                                <td class="bart-times bart-time"><span class="label {{ meta_size }} bart-times__list">{{ g_times }}</span></td>
                            </tr>
                        {% endif %}{% endfor %}
                    {% else %}
                        {% for d in departures %}
                            {% capture tok %},{{ forloop.index0 }},{% endcapture %}
                            {% if shown_idx contains tok %}
                                {% assign d_color = d.line | split: "-" | first %}
                                <tr>
                                    <td class="bart-dest"><span class="label {{ dest_size }}">{{ d.dest }}</span></td>
                                    <td class="bart-fit bart-line"><span class="label label--outline {{ meta_size }}">{{ d_color | upcase }}</span></td>
                                    <td class="bart-fit bart-time"><span class="label {{ meta_size }}">{{ d.time | date: "%s" | plus: trmnl.user.utc_offset | date: "%-I:%M %p" }}</span></td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    </tbody>
                </table>

            {% elsif departures and departures.size > 0 %}
                <span class="label">No upcoming trains match your filters. Try adjusting Direction or Line(s) in settings.</span>
            {% else %}
                <span class="label">No upcoming trains</span>
            {% endif %}

        </div>
    </div>
    {% comment %}decorative train: only shown when it fits below the last row; position follows the minute so it "cruises" across refreshes{% endcomment %}
    <div class="bart-lane">
        <div class="bart-lane__probe"></div>
        <div class="bart-lane__track">
            <svg class="bart-train" style="margin-left: max(0px, calc((100% - 333px) * {{ train_pos }}))" width="333" height="40" viewBox="-50 0 500 60" xmlns="http://www.w3.org/2000/svg">
                <g stroke="#000" stroke-width="3" stroke-linecap="round">
                    <line x1="-26" y1="18" x2="-6" y2="18"/><line x1="-46" y1="28" x2="-6" y2="28"/><line x1="-36" y1="38" x2="-6" y2="38"/><line x1="-20" y1="46" x2="-6" y2="46"/>
                </g>
                <g fill="#000"><rect x="144" y="28" width="10" height="3"/><rect x="292" y="28" width="10" height="3"/></g>
                {% for car_x in (0..1) %}
                <g transform="translate({{ car_x | times: 148 }} 0)">
                    <path d="M10 12 H144 V48 H6 V16 Q6 12 10 12 Z" fill="#fff" stroke="#000" stroke-width="3"/>
                    <g fill="#000">
                        <rect x="16" y="18" width="18" height="10" rx="2"/><rect x="58" y="18" width="18" height="10" rx="2"/><rect x="100" y="18" width="18" height="10" rx="2"/>
                        <rect x="6" y="34" width="138" height="4"/>
                        <circle cx="26" cy="53" r="5"/><circle cx="40" cy="53" r="5"/><circle cx="110" cy="53" r="5"/><circle cx="124" cy="53" r="5"/>
                    </g>
                    <g fill="none" stroke="#000" stroke-width="2"><rect x="40" y="16" width="12" height="28"/><rect x="82" y="16" width="12" height="28"/></g>
                </g>
                {% endfor %}
                <g transform="translate(148 0)">
                    <path d="M154 12 H266 Q282 12 289 27 L296 43 Q297 48 292 48 H154 Z" fill="#fff" stroke="#000" stroke-width="3"/>
                    <g fill="#000">
                        <rect x="164" y="18" width="18" height="10" rx="2"/><rect x="206" y="18" width="18" height="10" rx="2"/>
                        <path d="M252 17 H266 Q278 17 284 30 H252 Z"/>
                        <rect x="154" y="34" width="140" height="4"/>
                        <circle cx="174" cy="53" r="5"/><circle cx="188" cy="53" r="5"/><circle cx="260" cy="53" r="5"/><circle cx="274" cy="53" r="5"/>
                    </g>
                    <g fill="none" stroke="#000" stroke-width="2"><rect x="188" y="16" width="12" height="28"/><rect x="230" y="16" width="12" height="28"/></g>
                </g>
            </svg>
        </div>
    </div>
</div>

<div class="title_bar">
    <img class="image" src="https://raw.githubusercontent.com/garretth95/bart-departures-trmnl-plugin/refs/heads/main/train.png">
    <span class="title">BART Departures</span>
    <span class="instance">
    {{ stopname }}
  </span>
</div>
